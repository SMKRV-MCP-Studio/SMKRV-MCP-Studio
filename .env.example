# SMKRV MCP Studio - Environment Variables
# Copy this file to .env and edit as needed

# --- Required ---
# Encryption key for stored credentials (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
STUDIO_ENCRYPTION_KEY=

# JWT secret for admin authentication (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
STUDIO_JWT_SECRET=

# Redis password (internal, used by all services; generate: openssl rand -base64 32)
REDIS_PASSWORD=

# Agent service token (for agent-mcp and backend communication; generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
STUDIO_AGENT_SERVICE_TOKEN=

# --- Optional ---
# Admin account is not set here - create it on first launch through the web UI Setup screen.

# Prompt injection guard. L0 regex runs out of the box. The L1 DeBERTa ONNX layer
# is included but opt-in: set ML_DOWNLOAD=true to fetch the model (~180 MB, on first
# boot into the data volume, +~300 MB RAM).
# STUDIO_PROMPT_GUARD_ENABLED=true
# STUDIO_PROMPT_GUARD_ML_DOWNLOAD=true

# --- SSL / Let's Encrypt (optional) ---
# Use Let's Encrypt staging environment for testing (default: false)
# STUDIO_SSL_STAGING=false
# External HTTPS port for HTTP to HTTPS redirects (default: 443)
# STUDIO_EXTERNAL_HTTPS_PORT=443
